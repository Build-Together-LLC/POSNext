  "html": "<!DOCTYPE html>\n<html>\n\n<head>\n    <meta charset=\"UTF-8\">\n\n    <style>\n        .print-format td,\n        .print-format th {\n            padding: 1px !important;\n            color: black !important;\n        }\n\n        table,\n        th,\n        td {\n            margin-top: 2px;\n        }\n\n        .center-text {\n            text-align: center;\n        }\n    </style>\n\n</head>\n\n<body>\n\n<div id=\"header-html\" class=\"visible-pdf\">\n    <p></p>\n</div>\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n    <p class=\"text-center small page-number visible-pdf\">\n        Page <span class=\"page\"></span> of\n        <span class=\"topage\"></span>\n    </p>\n</div>\n\n{% set address = None %}\n\n{% if doc.customer_address %}\n    {% set address = frappe.get_doc(\"Address\", doc.customer_address) %}\n{% endif %}\n\n<div class=\"text-center\" style=\"margin-bottom:5px;\">\n\n    <b style=\"font-size:16px;\">TAX INVOICE</b>\n\n</div>\n\n<table border=\"1\"\ncellpadding=\"4\"\ncellspacing=\"0\"\nstyle=\"font-size:10px;\nwidth:100%;\nword-wrap:break-word;\noverflow-x:scroll;\">\n\n    <tr style=\"border:1px solid black;\">\n\n        <td width=\"65%\" style=\"border:none; vertical-align:top;\">\n\n            <b style=\"font-size:13px;\">\n\n                {{ doc.customer_name }}\n\n            </b>\n\n            <p style=\"font-size:11px; margin:2px 0 0 0;\">\n\n                {{ doc.address_display or \"\" }}\n\n                {% if address and address.phone %}\n                    Phone: {{ address.phone }}<br>\n                {% endif %}\n\n                {% if address and address.get(\"gstin\") %}\n                    GSTIN: {{ address.get(\"gstin\") }}\n                {% elif doc.tax_id %}\n                    GSTIN: {{ doc.tax_id }}\n                {% endif %}\n\n            </p>\n\n        </td>\n\n        <td width=\"35%\" style=\"border:none; text-align:right; vertical-align:top;\">\n\n            <b style=\"font-size:12px;\">\n\n                Invoice No:\n                &nbsp;{{ doc.name }}\n\n            </b>\n\n            <br>\n\n            <b style=\"font-size:12px;\">\n\n                Date :\n                &nbsp;\n                {{ frappe.utils.format_date(doc.posting_date)\n                if doc.posting_date\n                else doc.modified | string | truncate(10, False, '') }}\n\n            </b>\n\n        </td>\n\n    </tr>\n\n</table>\n\n<div class=\"text-center\"\nstyle=\"margin-top:5px;\nmargin-bottom:5px;\">\n\n    {% if doc.docstatus == 0 %}\n        <h4 style=\"margin:0px;\">DRAFT</h4>\n    {% elif doc.docstatus == 1 %}\n        <h4 style=\"margin:0px;\">SUBMITTED</h4>\n    {% elif doc.docstatus == 2 %}\n        <h4 style=\"margin:0px;\">CANCELLED</h4>\n    {% endif %}\n\n</div>\n\n<table border=\"1\"\ncellpadding=\"0\"\ncellspacing=\"0\"\nstyle=\"font-size:10px;\nwidth:100%;\ntable-layout:fixed;\nword-wrap:break-word;\noverflow-wrap:break-word;\">\n\n    <thead>\n\n        <tr style=\"border-bottom:1px solid black;\">\n\n            <th style=\"text-align:left;\n            font-size:12px;\n            border:none;\n            word-wrap:break-word;\n            overflow-wrap:break-word;\"\n            width=\"10%\">\n\n                <b>SNO.</b>\n\n            </th>\n\n            <th style=\"text-align:left;\n            font-size:12px;\n            border:none;\n            word-wrap:break-word;\n            overflow-wrap:break-word;\"\n            width=\"35%\">\n\n                <b>ITEM NAME</b>\n\n            </th>\n\n            <th style=\"text-align:left;\n            font-size:12px;\n            border:none;\n            word-wrap:break-word;\n            overflow-wrap:break-word;\"\n            width=\"20%\">\n\n                <b>CODE</b>\n\n            </th>\n\n            <th style=\"text-align:left;\n            font-size:12px;\n            border:none;\n            word-wrap:break-word;\n            overflow-wrap:break-word;\"\n            width=\"15%\">\n\n                <b>QTY</b>\n\n            </th>\n\n            <th style=\"text-align:left;\n            font-size:12px;\n            border-left:none;\n            border-top:none;\n            word-wrap:break-word;\n            overflow-wrap:break-word;\"\n            width=\"20%\">\n\n                <b>M.R.P</b>\n\n            </th>\n\n        </tr>\n\n    </thead>\n\n    <tbody style=\"font-size:12px;\">\n\n        {% set grouped_items = {} %}\n\n        {% for item in doc.items|sort(attribute='item_name') %}\n\n            {% set parent_brand = item.brand or \"\" %}\n\n            {% if parent_brand not in grouped_items %}\n\n                {% set _ =\n                    grouped_items.update({\n                    parent_brand: []\n                }) %}\n\n            {% endif %}\n\n            {% set _ =\n                grouped_items[parent_brand].append(item) %}\n\n        {% endfor %}\n\n        {% set serial_number = {'count': 0} %}\n\n        {% for parent_brand, items\n            in grouped_items|dictsort %}\n\n            <tr>\n\n                <td colspan=\"5\"\n                style=\"text-align:left;\n                font-size:12px;\">\n\n                    <b style=\"padding-left:3%;\">\n\n                        {{ parent_brand }}\n\n                    </b>\n\n                </td>\n\n            </tr>\n\n            {% for item in items %}\n\n                {% set item_price =\n                    item.price_list_rate or \"\" %}\n\n                {% set _ =\n                    serial_number.update({\n                    'count':\n                    serial_number.count + 1\n                }) %}\n\n                <tr>\n\n                    <td style=\"text-align:left;\n                    font-size:12px;\n                    border:none;\n                    word-wrap:break-word;\n                    overflow-wrap:break-word;\">\n\n                        {{ serial_number.count }}\n\n                    </td>\n\n                    <td style=\"text-align:left;\n                    font-size:12px;\n                    border:none;\n                    word-wrap:break-word;\n                    overflow-wrap:break-word;\">\n\n                        {{ item.item_name }}\n\n                    </td>\n\n                    <td style=\"text-align:left;\n                    font-size:12px;\n                    border:none;\n                    word-wrap:break-word;\n                    overflow-wrap:break-word;\">\n\n                        {{ item.item_code }}\n\n                    </td>\n\n                    <td style=\"text-align:left;\n                    font-size:12px;\n                    border:none;\n                    word-wrap:break-word;\n                    overflow-wrap:break-word;\">\n\n                        {{ item.qty\n                        if item.qty % 1\n                        else item.qty | int }}\n\n                    </td>\n\n                    <td style=\"text-align:left;\n                    font-size:12px;\n                    border-left:none;\n                    border-bottom:none;\n                    border-top:none;\n                    word-wrap:break-word;\n                    overflow-wrap:break-word;\">\n\n                        {{ item_price }}\n\n                    </td>\n\n                </tr>\n\n            {% endfor %}\n\n        {% endfor %}\n\n    </tbody>\n\n</table>\n\n</body>\n</html>",
